<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <com.brosco.assistant.GalaxyBackgroundView
        android:id="@+id/galaxyBackground"
        android:layout_width="match_parent"
        android:layout_height="match_parent"/>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical">

        <!-- Header -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:gravity="center"
            android:paddingTop="18dp"
            android:paddingBottom="6dp">

            <TextView
                android:id="@+id/statusText"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Brosco"
                android:textSize="24sp"
                android:textStyle="bold"
                android:letterSpacing="0.02"
                android:textColor="#FFFFFF"/>

        </LinearLayout>

        <!-- Chat transcript, Claude-style: scrolls, bubbles grow with content -->
        <ScrollView
            android:id="@+id/chatScroll"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:scrollbars="none"
            android:fillViewport="true"
            android:clipToPadding="false">

            <LinearLayout
                android:id="@+id/chatContainer"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingStart="14dp"
                android:paddingEnd="14dp"
                android:paddingTop="8dp"
                android:paddingBottom="12dp">

                <TextView
                    android:id="@+id/emptyStateText"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="70dp"
                    android:text="Tap the mic, type below, or enable listening."
                    android:textSize="15sp"
                    android:textColor="#9B95C9"
                    android:gravity="center"/>

            </LinearLayout>
        </ScrollView>

        <!-- Mic with animated pulse rings behind it -->
        <FrameLayout
            android:layout_width="150dp"
            android:layout_height="150dp"
            android:layout_gravity="center_horizontal"
            android:layout_marginBottom="4dp">

            <View
                android:id="@+id/pulseRing1"
                android:layout_width="110dp"
                android:layout_height="110dp"
                android:layout_gravity="center"
                android:background="@drawable/pulse_ring"
                android:alpha="0"/>

            <View
                android:id="@+id/pulseRing2"
                android:layout_width="110dp"
                android:layout_height="110dp"
                android:layout_gravity="center"
                android:background="@drawable/pulse_ring"
                android:alpha="0"/>

            <Button
                android:id="@+id/micButton"
                android:layout_width="84dp"
                android:layout_height="84dp"
                android:layout_gravity="center"
                android:background="@drawable/mic_button_bg"
                android:text="🎤"
                android:textSize="30sp"
                android:stateListAnimator="@null"
                android:elevation="8dp"/>

        </FrameLayout>

        <!-- Docked input bar -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="20dp"
            android:paddingEnd="20dp"
            android:paddingBottom="16dp">

            <EditText
                android:id="@+id/textInput"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:minHeight="52dp"
                android:background="@drawable/rounded_input_bg"
                android:hint="Type a command instead..."
                android:textColorHint="#6E6795"
                android:textColor="#FFFFFF"
                android:textSize="15sp"
                android:layout_marginBottom="10dp"/>

            <Button
                android:id="@+id/sendTextButton"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:background="@drawable/rounded_button_primary"
                android:text="SEND"
                android:textColor="#FFFFFF"
                android:textStyle="bold"
                android:stateListAnimator="@null"
                android:layout_marginBottom="10dp"/>

            <Button
                android:id="@+id/attachButton"
                android:layout_width="match_parent"
                android:layout_height="44dp"
                android:background="@drawable/rounded_button_outline"
                android:text="📎 ATTACH PHOTO, VIDEO, OR FILE"
                android:textColor="#C9C3F5"
                android:textSize="12sp"
                android:stateListAnimator="@null"
                android:layout_marginBottom="10dp"/>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <Button
                    android:id="@+id/alwaysListenButton"
                    android:layout_width="0dp"
                    android:layout_height="44dp"
                    android:layout_weight="1"
                    android:layout_marginEnd="6dp"
                    android:background="@drawable/rounded_button_outline"
                    android:text="ALWAYS-LISTEN"
                    android:textColor="#C9C3F5"
                    android:textSize="10sp"
                    android:stateListAnimator="@null"/>

                <Button
                    android:id="@+id/backgroundServiceButton"
                    android:layout_width="0dp"
                    android:layout_height="44dp"
                    android:layout_weight="1"
                    android:layout_marginStart="6dp"
                    android:background="@drawable/rounded_button_outline"
                    android:text="BACKGROUND BROSCO"
                    android:textColor="#C9C3F5"
                    android:textSize="10sp"
                    android:stateListAnimator="@null"/>

            </LinearLayout>

        </LinearLayout>

    </LinearLayout>
</FrameLayout>
