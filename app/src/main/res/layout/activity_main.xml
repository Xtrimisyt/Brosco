<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:gravity="center"
    android:padding="32dp"
    android:background="#101014">

    <TextView
        android:id="@+id/statusText"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Brosco"
        android:textSize="28sp"
        android:textColor="#FFFFFF"
        android:layout_marginBottom="16dp"/>

    <TextView
        android:id="@+id/responseText"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Tap the mic, type below, or enable listening."
        android:textSize="16sp"
        android:textColor="#B0B0B0"
        android:gravity="center"
        android:layout_marginBottom="24dp"/>

    <Button
        android:id="@+id/micButton"
        android:layout_width="120dp"
        android:layout_height="120dp"
        android:text="🎤"
        android:textSize="36sp"
        android:layout_marginBottom="20dp"/>

    <EditText
        android:id="@+id/textInput"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:hint="Type a command instead..."
        android:textColorHint="#777777"
        android:textColor="#FFFFFF"
        android:padding="12dp"
        android:layout_marginBottom="12dp"/>

    <Button
        android:id="@+id/sendTextButton"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Send"
        android:layout_marginBottom="20dp"/>

    <Button
        android:id="@+id/alwaysListenButton"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Enable Always-Listen (app open)"
        android:layout_marginBottom="12dp"/>

    <Button
        android:id="@+id/backgroundServiceButton"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Start Background Brosco"/>

</LinearLayout>
